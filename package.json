{
  "name": "enforce-commit-status",
  "version": "1.0.0",
  "private": true,
  "description": "Synchronous gatekeeper action; suspends build runner pending definitive test resolution.",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run --coverage",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "suppressions": "script/forbidden_suppressions.sh",
    "knip": "knip",
    "duplication": "jscpd",
    "audit": "npm audit",
    "outdated": "node script/outdated.ts",
    "mutation": "stryker run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run suppressions && npm run knip && npm run duplication && npm test && npm run audit",
    "prepare": "husky",
    "scorecard": "node script/dependency_scorecard.ts"
  },
  "keywords": [
    "actions",
    "github",
    "github-actions",
    "workflow",
    "ci",
    "gatekeeper",
    "commit-status",
    "status"
  ],
  "author": "Vitalii Lazebnyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitaliiLazebnyi/enforce-commit-status.git"
  },
  "homepage": "https://github.com/VitaliiLazebnyi/enforce-commit-status#readme",
  "bugs": {
    "url": "https://github.com/VitaliiLazebnyi/enforce-commit-status/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "ms": "2.1.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/ms": "2.1.0",
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-unicorn": "79.0.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@12.2.1",
  "overrides": {
    "qs": "6.17.1"
  }
}
