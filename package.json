{
  "name": "enforce-commit-status",
  "version": "1.0.0",
  "private": true,
  "description": "Synchronous gatekeeper action; suspends build runner pending definitive test resolution.",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "keywords": [
    "actions",
    "github",
    "github-actions",
    "workflow",
    "ci",
    "gatekeeper",
    "commit-status",
    "status"
  ],
  "author": "Vitalii Lazebnyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitaliiLazebnyi/enforce-commit-status.git"
  },
  "homepage": "https://github.com/VitaliiLazebnyi/enforce-commit-status#readme",
  "bugs": {
    "url": "https://github.com/VitaliiLazebnyi/enforce-commit-status/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.2.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
